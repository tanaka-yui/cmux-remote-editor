{
  "name": "@tanaka-yui/cmux-remote-editor-client",
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "check": "tsc --noEmit && biome check ./src",
    "check:fix": "biome check --write ./src",
    "dev": "vite",
    "format": "biome format ./src && biome format ./public",
    "format:fix": "biome format --write ./src && biome format --write ./public",
    "lint": "biome lint ./src && biome lint ./public",
    "lint:fix": "biome lint --write ./src && biome lint --write ./public",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/m-plus-1-code": "^5.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@wterm/dom": "0.3.0",
    "@wterm/react": "0.3.0",
    "lucide-react": "^1.20.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.8",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "7.4.1"
  }
}
